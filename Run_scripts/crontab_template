# ===============================================
# Production WRF runs (4 times per day: 00, 06, 12, 18 UTC)
# ===============================================
#30 * * * * @BASE_DIR@/scripts/clean_wrf.sh
#30 5 * * * @BASE_DIR@/scripts/control_run_WRF.sh 00 > @BASE_DIR@/logs/runlog_00.log 2>&1
#30 11 * * * @BASE_DIR@/scripts/control_run_WRF.sh 06 > @BASE_DIR@/logs/runlog_06.log 2>&1
#30 17 * * * @BASE_DIR@/scripts/control_run_WRF.sh 12 > @BASE_DIR@/logs/runlog_12.log 2>&1
#30 23 * * * @BASE_DIR@/scripts/control_run_WRF.sh 18 > @BASE_DIR@/logs/runlog_18.log 2>&1

# ===============================================
# WRF test runs (2 times per day: 00, 12 UTC)
# ===============================================
#0 6 * * * @TEST_BASE_DIR@/scripts/control_run_WRF_test.sh 00 > @TEST_BASE_DIR@/logs/runlog_00.log 2>&1
#0 18 * * * @TEST_BASE_DIR@/scripts/control_run_WRF_test.sh 12 > @TEST_BASE_DIR@/logs/runlog_12.log 2>&1